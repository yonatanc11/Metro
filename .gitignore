# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

# Claude Code / MCP — nothing new gets committed
.claude/*
!.claude/settings.json
.mcp.json

.nx/polygraph

# Next.js
.next
out

# local env files (standard Next.js pattern)
.env*.local

# local dev harness pages (never committed)
apps/web/src/app/dev/

# Strapi regenerates these on every dev boot / build
apps/cms/types/generated/

# one-off seed scripts — local-only, data lives in the cloud
apps/cms/scripts/

test-output
