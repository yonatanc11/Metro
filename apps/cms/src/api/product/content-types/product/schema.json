{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "A motorcycle accessory product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "enumeration",
      "enum": ["USD", "EUR", "ILS"],
      "default": "ILS",
      "required": true
    },
    "rating": {
      "type": "decimal",
      "min": 0,
      "max": 5
    },
    "reviewCount": {
      "type": "integer",
      "min": 0
    },
    "badgeLabel": {
      "type": "string"
    },
    "badgeTone": {
      "type": "enumeration",
      "enum": ["new", "sale", "feature"]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": ["images"]
    },
    "specs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.spec"
    },
    "categorySpecs": {
      "type": "dynamiczone",
      "components": ["helmet.safety", "glove.protection", "coat.armor"]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "ctaLabel": {
      "type": "string"
    },
    "shippingNote": {
      "type": "string"
    },
    "pageSections": {
      "type": "dynamiczone",
      "components": ["sections.rich-content"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "products"
    }
  }
}
